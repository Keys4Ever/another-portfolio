---
import meimei from "../assets/img/meimei.png";
import meow from "../assets/audio/meow.m4a";
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<slot />
		<img
			id="meimei"
			src={meimei.src}
			alt=""
			draggable="false"
			aria-hidden="true"
			class="pointer-events-none fixed top-0 left-0 z-40 w-20 select-none opacity-0 max-md:hidden"
		/>
		<audio id="meimei-meow" src={meow} preload="none"></audio>
		<script>
			const el = document.getElementById("meimei");
			const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
			if (el && fine) {
				let cx = 0;
				let cy = 0;
				let seen = false;
				const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
				const k = reduced ? 1 : 0.02;
				const lag = reduced ? 0 : 190;
				const trail = [];
				const tick = () => {
					const now = performance.now();
					while (trail.length > 1 && now - trail[0].t >= lag) trail.shift();
					const target = trail[0];
					if (target) {
						cx += (target.x - cx) * k;
						cy += (target.y - cy) * k;
						el.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -78%)`;
					}
					requestAnimationFrame(tick);
				};
				addEventListener(
					"pointermove",
					(e) => {
						trail.push({ t: performance.now(), x: e.clientX, y: e.clientY });
						if (!seen) {
							cx = e.clientX;
							cy = e.clientY;
							seen = true;
							el.style.opacity = "0.6";
							requestAnimationFrame(tick);
						}
					},
					{ passive: true },
				);
				const sound = document.getElementById("meimei-meow");
				let clicks = 0;
				addEventListener("click", (e) => {
					const r = el.getBoundingClientRect();
					if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
					if (++clicks < 5) return;
					clicks = 0;
					sound.currentTime = 0;
					sound.play().catch(() => {});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	@import "../styles/global.css";
</style>
